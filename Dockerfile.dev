FROM node:18-slim

WORKDIR /usr/src/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    python3 \
    build-essential \
    procps \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 3000

# Source is bind-mounted in by docker-compose; install/generate/migrate happen
# at container start so the (named-volume) node_modules always match this
# container's OS/arch instead of whatever built them on the host.
CMD ["sh", "-c", "npm install && npx prisma generate && npx prisma migrate deploy && npm run start:dev"]
