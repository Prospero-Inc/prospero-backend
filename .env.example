# Mail Configuration
MAIL_HOST=       # The SMTP server hostname or IP address
MAIL_SERVICE=    # The email service provider (e.g., 'gmail', 'hotmail')
MAIL_PORT=       # The port to connect to the mail server (usually 587 for TLS, 465 for SSL)
MAIL_USER=       # The email address to use for sending emails
MAIL_PASSWORD=   # The password or app-specific password for the email account
MAIL_FROM=       # The default "From" address for outgoing emails

# API Configuration
# NOTE: must end with a trailing slash — links are built as `${BASE}auth/...`
API_BASE_URL=    # Base URL for API endpoints (used in the account activation email)

# NOTE: must end with a trailing slash too — this should point at the
# prosper-change-password app, not this API
API_BASE_URL_RESET= # Base URL for password reset links

# Optional Mail Transport
MAIL_TRANSPORT=  # Custom mail transport configuration if needed

# Doppler Token for environment management
DOPPLER_TOKEN_API= # Token for accessing Doppler API

# JWT Secret Key for signing tokens
SECRET=          # Secret key for JWT signing and verification

# Database Configuration
DATABASE_URL=    # URL for connecting to the PostgreSQL database
DIRECT_URL=      # Direct URL for database migrations

# Gmail ingestion feature (Phase 2 — OAuth connect flow). Google Cloud
# project "prospero-509219", OAuth client "prospero-backend-gmail".
GMAIL_OAUTH_CLIENT_ID=      # OAuth 2.0 Client ID from Google Cloud Console
GMAIL_OAUTH_CLIENT_SECRET=  # OAuth 2.0 Client Secret from Google Cloud Console
GMAIL_OAUTH_REDIRECT_URI=   # must include the /api global prefix, e.g. http://localhost:3000/api/gmail/oauth/callback in dev
GMAIL_TOKEN_ENCRYPTION_KEY= # 32 random bytes, base64 (openssl rand -base64 32) — encrypts access/refresh tokens at rest
GMAIL_OAUTH_SUCCESS_REDIRECT_URL= # Frontend URL /gmail/oauth/callback redirects to after connecting/failing, e.g. http://localhost:4000/settings

