generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    Int                    @id @default(autoincrement())
  username              String                 @unique
  isActive              Boolean                @default(false) @map("is_active")
  isGoogleAccount       Boolean                @default(false) @map("is_google_account")
  activationToken       String?                @unique @map("activation_token")
  transactions          Transaction[]
  fixedExpenses         FixedExpense[]
  salary                Salary[]
  refreshTokens         RefreshToken[]
  financialInstitutions FinancialInstitution[]
  gmailConnection       GmailConnection?
  processedEmails       ProcessedEmail[]
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  apiKey                String?                @unique @map("api_key")
  enable2FA             Boolean                @default(false) @map("enable_2fa")
  twoFASecret           String?                @map("2fa_secret")
  qr2FA                 String?                @map("qr_2fa")
  password              String?
  email                 String                 @unique
  lastName              String?                @map("last_name")
  firstName             String?                @map("first_name")
  resetPasswordToken    String?                @map("reset_password_token")
  payFrequency          PayFrequency           @default(Biweekly) @map("pay_frequency")
  needsPercent          Float                  @default(0.5) @map("needs_percent")
  wantsPercent          Float                  @default(0.3) @map("wants_percent")
  savingsPercent        Float                  @default(0.2) @map("savings_percent")

  @@index([username, email], name: "user_search_idx")
  @@map("users")
}

enum PayFrequency {
  Biweekly
  Monthly
}

model Transaction {
  id              Int                     @id @default(autoincrement())
  userId          Int                     @map("user_id")
  user            User                    @relation(fields: [userId], references: [id])
  amount          Float
  date            DateTime
  category        BudgetCategory?
  description     String?
  periodOverride  PeriodOverride?         @map("period_override")
  fixedExpenseId  Int?                    @map("fixed_expense_id")
  fixedExpense    FixedExpense?           @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)
  source          MovementSource          @default(Manual)
  reviewStatus    TransactionReviewStatus @default(Confirmed) @map("review_status")
  institutionId   Int?                    @map("institution_id")
  institution     FinancialInstitution?   @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  gmailMessageId  String?                 @map("gmail_message_id")
  processedEmails ProcessedEmail[]
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@index([date, category], name: "transaction_date_category_idx")
  @@map("transactions")
}

enum BudgetCategory {
  Necesidad
  Deseo
  Ahorro
}

enum PeriodOverride {
  Previous
  Current
}

model FixedExpense {
  id             Int            @id @default(autoincrement())
  userId         Int            @map("user_id")
  user           User           @relation(fields: [userId], references: [id])
  amount         Float
  name           String
  budgetCategory BudgetCategory @map("budget_category")
  dueDate        DateTime       @map("due_date")
  reminder       Boolean
  description    String?
  transactions   Transaction[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([userId, dueDate], name: "fixed_expense_user_due_date_idx")
  @@map("fixed_expenses")
}

model Salary {
  id                      Int                   @id @default(autoincrement())
  userId                  Int                   @map("user_id")
  user                    User                  @relation(fields: [userId], references: [id])
  amount                  Float
  date                    DateTime
  type                    IncomeType            @default(Payroll)
  budgetCategory          BudgetCategory?       @map("budget_category")
  distributeAutomatically Boolean               @default(false) @map("distribute_automatically")
  source                  MovementSource        @default(Manual)
  status                  IncomeReviewStatus    @default(Classified)
  incomeCategory          IncomeCategory?       @map("income_category")
  institutionId           Int?                  @map("institution_id")
  institution             FinancialInstitution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  gmailMessageId          String?               @map("gmail_message_id")
  processedEmails         ProcessedEmail[]
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  @@index([userId, date], name: "salary_user_date_idx")
  @@map("salaries")
}

enum IncomeType {
  Payroll
  Extra
}

enum MovementSource {
  Manual
  Gmail
}

enum TransactionReviewStatus {
  Detected
  PendingReview
  Confirmed
}

enum IncomeReviewStatus {
  Detected
  PendingReview
  Classified
}

enum IncomeCategory {
  Payroll
  Extra
  Transfer
  Reimbursement
  Deposit
  Other
}

enum ProcessedEmailResult {
  Created
  Ignored
  Failed
  NeedsReview
  PossibleDuplicate
}

enum GmailConnectionStatus {
  Connected
  Disconnected
  Expired
  Revoked
}

model RefreshToken {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model FinancialInstitution {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @map("user_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  isActive     Boolean             @default(true) @map("is_active")
  // Key into the code-level parser registry (BankParserRegistry), NOT a
  // Postgres enum on purpose: adding support for a new bank should never
  // require a migration. Unknown/absent keys just mean "no parser
  // configured yet" — see gmail-sync's registry for the source of truth.
  parserKey    String?             @map("parser_key")
  senders      InstitutionSender[]
  transactions Transaction[]
  salaries     Salary[]
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([userId])
  @@map("financial_institutions")
}

model InstitutionSender {
  id            Int                  @id @default(autoincrement())
  institutionId Int                  @map("institution_id")
  institution   FinancialInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  emailAddress  String               @map("email_address")
  createdAt     DateTime             @default(now()) @map("created_at")

  @@unique([institutionId, emailAddress])
  @@map("institution_senders")
}

model GmailConnection {
  id                    Int                   @id @default(autoincrement())
  userId                Int                   @unique @map("user_id")
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedAccessToken  String                @map("encrypted_access_token")
  encryptedRefreshToken String                @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime?             @map("token_expires_at")
  grantedScope          String?               @map("granted_scope")
  lastHistoryId         String?               @map("last_history_id")
  lastSyncAt            DateTime?             @map("last_sync_at")
  status                GmailConnectionStatus @default(Connected)
  autoDetectEnabled     Boolean               @default(true) @map("auto_detect_enabled")
  notifyIncomeEnabled   Boolean               @default(true) @map("notify_income_enabled")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@map("gmail_connections")
}

model ProcessedEmail {
  id                   Int                  @id @default(autoincrement())
  userId               Int                  @map("user_id")
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId       String               @map("gmail_message_id")
  senderEmail          String?              @map("sender_email")
  result               ProcessedEmailResult
  reason               String?
  parserVersion        String?              @map("parser_version")
  relatedTransactionId Int?                 @map("related_transaction_id")
  relatedTransaction   Transaction?         @relation(fields: [relatedTransactionId], references: [id], onDelete: SetNull)
  relatedSalaryId      Int?                 @map("related_salary_id")
  relatedSalary        Salary?              @relation(fields: [relatedSalaryId], references: [id], onDelete: SetNull)
  // Snapshot of what the parser actually extracted, captured at
  // detection time regardless of `result` — needed so a PossibleDuplicate
  // row can later be turned into a real Transaction via the
  // "create-anyway" flow without ever inventing amount/date/description.
  // Nullable because older rows (pre-migration) never had this captured.
  parsedAmount         Float?               @map("parsed_amount")
  parsedDate           DateTime?            @map("parsed_date")
  parsedDescription    String?              @map("parsed_description")
  // Set once the user has acted on a PossibleDuplicate (via "create
  // anyway" or, in the future, an explicit dismiss) so the
  // possibleGmailDuplicate badge on the related transaction stops
  // appearing. Null means "still awaiting user action".
  resolvedAt           DateTime?            @map("resolved_at")
  processedAt          DateTime             @default(now()) @map("processed_at")

  @@unique([userId, gmailMessageId])
  // Supports the possibleGmailDuplicate lookup transactions/salary do on
  // every list read: "find an unresolved PossibleDuplicate email pointing
  // at this row".
  @@index([relatedTransactionId, result, resolvedAt])
  @@index([relatedSalaryId, result, resolvedAt])
  @@map("processed_emails")
}
